# Modèle d'environnement — commité, et vide de valeurs.
# Copier en .env.local (gitignoré, jamais commité) et renseigner.
#
# .env.local est le seul fichier qui diffère entre le PC maison et le PC
# Shadow, et il n'a pas à être synchronisé.

# Base de développement distante, jointe par tunnel SSH sur localhost:5433.
# Le tunnel doit être ouvert avant toute commande qui touche la base
# (cf. CLAUDE.md §Deux postes de développement). Garder connection_limit=5.
# Forme attendue :
#   postgresql://hch:<mot de passe>@localhost:5433/hch?connection_limit=5
DATABASE_URL=

# Clé de signature des sessions (HS256, jose). 32 octets aléatoires :
#   openssl rand -base64 32
# Sans elle, `createSession` échoue et la connexion est impossible — l'erreur
# est bruyante côté serveur et opaque côté utilisateur. Distincte de celle de
# staging et de production.
SESSION_SECRET=

# Mot de passe des deux administrateurs posés par `prisma/seed.ts`, et donc
# celui du formulaire de connexion. Le seed échoue explicitement si la variable
# est absente : il n'existe pas de valeur par défaut, une valeur en dur dans le
# dépôt deviendrait un identifiant public le jour de la bascule.
SEED_ADMIN_PASSWORD=

# Transport email (ADR-017) — `gmail` ou `noop`, aucune valeur par défaut.
# Sur le poste : `noop`. Le lien d'activation est alors écrit dans la console du
# serveur de développement, préfixé `[email:noop]`, et l'inscription se joue à la
# main sans boîte email.
# `gmail` exige GMAIL_APP_PASSWORD, GMAIL_FROM_ADDRESS et NEXT_PUBLIC_APP_URL —
# à ne mettre ici que pour éprouver un envoi réel depuis le poste.
HCH_MAIL_TRANSPORT=noop
GMAIL_APP_PASSWORD=
GMAIL_FROM_ADDRESS=

# Origine publique. Facultative en transport `noop` — `src/lib/env.ts` retombe
# alors sur http://localhost:3000, ce qui suffit puisque personne ne clique le
# lien loggé.
NEXT_PUBLIC_APP_URL=
