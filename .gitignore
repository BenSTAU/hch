# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files — aucun secret dans le dépôt.
# Deux exceptions, commitées et vides de valeurs : le modèle du .env.local de
# chaque poste, et celui du .env.prod de chaque pile VPS.
.env*
!.env.example
!.env.prod.example

# journal des refus du garde testeur — trace locale d'exécution, pas un
# artefact versionné. Ce qui remonte au jury est la synthèse dans docs/ia/.
.claude/logs/
# sentinelle du testeur — état d'exécution, levée pendant qu'il tourne et
# retirée à son arrêt. Si elle traîne après un plantage, la supprimer.
.claude/.testeur-actif

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

/src/generated/prisma
