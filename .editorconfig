# Conventions de fichier, lues par l'éditeur avant tout formateur.
#
# Pose l'intention là où elle se décide : au moment de la frappe. Prettier
# reformate le contenu mais ne dit rien de l'encodage ni de la fin de ligne, et
# il PRÉSERVE un BOM existant au lieu de le retirer - c'est ainsi que neuf
# fichiers en ont porté un jusqu'à l'audit du 2026-08-12.
#
# La garde exécutable est la règle `unicode-bom` d'`eslint.config.mjs` : ce
# fichier-ci prévient, celle-là refuse.

root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 2

[*.md]
# Deux espaces en fin de ligne sont un retour à la ligne en Markdown.
trim_trailing_whitespace = false
