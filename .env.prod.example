# Modèle du .env.prod de chaque pile VPS — /opt/hch-staging/.env.prod et
# /opt/hch-prod/.env.prod. Ce fichier-ci est commité et vide de valeurs ; les
# vrais fichiers vivent sur le VPS en chmod 600, deployer:deployer, et ne sont
# jamais versionnés (PLAN S3 §6).
#
# Les deux piles partagent docker-compose.prod.yml : tout ce qui les distingue
# est ici. Les valeurs CHANGE_ME doivent être DISTINCTES entre staging et
# production — un secret partagé n'isole plus rien.
#
# Ce fichier joue DEUX rôles, et le second exige un drapeau :
#   1. `env_file:` l'injecte dans les conteneurs (DATABASE_URL, SESSION_SECRET…)
#   2. `--env-file .env.prod` le donne à la substitution des ${VAR} du compose
#      (IMAGE_TAG, HCH_ENV_*) — sans ce drapeau, compose refuse le fichier.

# ── Postgres — lu par le conteneur de base ET par l'application
POSTGRES_USER=hch
POSTGRES_PASSWORD=CHANGE_ME
POSTGRES_DB=hch

# ── Identité de la pile — substituée dans docker-compose.prod.yml
# staging : hch-app-staging / hch-postgres-staging
#           hch_staging_internal / hch_postgres_staging_data
# prod    : hch-app-prod    / hch-postgres-prod
#           hch_prod_internal    / hch_postgres_prod_data
#
# IMAGE_TAG est écrasé par le pipeline avec le SHA du commit déployé — la
# valeur ci-dessous ne sert qu'au premier démarrage manuel.
IMAGE_TAG=latest
HCH_ENV_CONTAINER_NAME=
HCH_ENV_POSTGRES_CONTAINER_NAME=
HCH_ENV_NETWORK_NAME=
HCH_ENV_VOLUME_NAME=

# ── Runtime applicatif
# L'hôte est le conteneur Postgres sur le réseau hch_internal, joignable par
# son nom de service comme par son container_name. Jamais d'IP, jamais de
# port publié : la base n'est pas exposée.
DATABASE_URL=
# openssl rand -base64 32 — valeur distincte par environnement
SESSION_SECRET=CHANGE_ME
# Mot de passe des administrateurs posés par `prisma/seed.ts`. Distinct entre
# staging et production, et distinct de celui du poste de développement.
SEED_ADMIN_PASSWORD=CHANGE_ME
# UN projet Google Cloud « HomeCycl'Home », DEUX clients OAuth (hch-staging-web
# et hch-prod-web), chacun avec ses propres Authorized redirect URIs. Les
# identifiants sont émis par client, pas par projet — mais l'écran de
# consentement est partagé (PLAN S3 §6, amendé le 2026-08-07).
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=CHANGE_ME
GOOGLE_REDIRECT_URI=
# Origine publique de la pile — https://hch-staging.glanford.eu ou
# https://hch.glanford.eu. Exigée dès que `HCH_MAIL_TRANSPORT=gmail` : c'est elle
# qui rend le lien d'activation absolu, donc cliquable dans un email.
NEXT_PUBLIC_APP_URL=
# Clé Google Maps JS de la carte de la tournée technicien (écran T1, ADR-015
# v3). UNE CLÉ PAR PILE, restreinte par referer sur le domaine de cette pile —
# hch-staging.glanford.eu ou hch.glanford.eu. Une clé partagée entre les deux
# ne serait restreignable sur aucun des deux domaines.
#
# ⚠️ FACULTATIVE, et c'est un risque assumé : absente, la pile démarre, le
# healthcheck reste vert, et la carte disparaît EN SILENCE — seule la liste des
# interventions s'affiche. Renseigner les DEUX piles, puis regarder l'écran T1
# après déploiement. Le seul signal côté serveur est une ligne
# `[carte] HCH_MAPS_API_KEY absente…` dans les logs du conteneur.
#
# Pas de préfixe NEXT_PUBLIC_ : il annoncerait une inlining au build que le
# stage builder ne peut pas faire, faute de variables. Lue au runtime serveur.
# Elle reste publique dans le HTML servi — la restriction par referer est sa
# seule protection réelle (ADR-015 v2 §D2), avec l'alerte de budget.
HCH_MAPS_API_KEY=

# ── Email transactionnel (ADR-017) — Gmail + nodemailer
# `gmail` sur les deux piles, `noop` sur le poste et la barrière E2E. AUCUNE
# valeur par défaut dans `src/lib/env.ts`, délibérément : un défaut à `noop`
# ferait qu'une pile mal configurée cesserait d'envoyer sans que rien ne le
# signale, alors qu'ADR-017 exige l'échec bruyant. Absente ⇒ /api/health répond
# 503, le conteneur est unhealthy, le rollback inline ramène l'image précédente.
HCH_MAIL_TRANSPORT=gmail
# Mot de passe d'application Google, 16 caractères SANS espaces. Exige la
# validation en deux étapes sur le compte émetteur.
# ⚠️ SEUL secret IDENTIQUE entre staging et production — un seul compte
# Google émet pour les deux. Écart assumé, tracé dans points-ouverts-hch.
GMAIL_APP_PASSWORD=CHANGE_ME
# Adresse du compte émetteur. Sert aussi de `replyTo` : le nom affiché est
# « HomeCycl'Home », l'adresse reste visible en second rideau.
GMAIL_FROM_ADDRESS=
